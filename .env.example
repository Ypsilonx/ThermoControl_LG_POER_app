# ============================================================
# .env.example – konfigurace LG ThinQ Klimatizace
# Zkopírujte na .env a vyplňte. Soubor .env NIKDY necommitujte!
#   cp .env.example .env
# Docker Compose .env načte automaticky.
# ============================================================

# --- Přihlašovací údaje ThinQ ---------------------------------
# Mají přednost před data/config.json. Pro produkci preferujte tyto.
LG_ACCESS_TOKEN=
LG_COUNTRY_CODE=CZ
LG_CLIENT_ID=

# --- Síť a běh serveru ----------------------------------------
LG_HOST=0.0.0.0
LG_PORT=8000
# debug | info | warning | error
LG_LOG_LEVEL=info
# Auto-reload kódu – POUZE pro vývoj, v produkci ponechte false.
LG_RELOAD=false

# --- Swagger / ReDoc ------------------------------------------
# V produkci ponechte false (nevystavovat API mapu na internet).
LG_DOCS_ENABLED=false

# --- Reverzní proxy (Cloudflare Tunnel / nginx) ---------------
# IP, jimž server věří X-Forwarded-* hlavičky. Za Cloudflare Tunnel
# přichází provoz z interní docker sítě – "*" je zde bezpečné, protože
# port serveru není vystaven na hostu (přístup jen přes tunel).
LG_FORWARDED_ALLOW_IPS=*

# --- Autentizace (Cloudflare Access / Zero Trust) -------------
# "none"       – bez ověření (jen lokální vývoj!)
# "cloudflare" – ověřuje podepsaný JWT z Cloudflare Access
LG_AUTH_MODE=none
# URL vašeho Zero Trust týmu (Cloudflare dashboard → Zero Trust → Settings).
# Příklad: https://muj-tym.cloudflareaccess.com
LG_CF_TEAM_DOMAIN=
# Application Audience (AUD) tag z Access aplikace
# (Zero Trust → Access → Applications → vaše aplikace → Overview).
LG_CF_AUD=

# --- Rate limiting --------------------------------------------
LG_RATE_LIMIT_ENABLED=true
# Max počet zápisových (POST/PUT/...) požadavků za okno na jednu IP.
LG_RATE_LIMIT_MAX=30
LG_RATE_LIMIT_WINDOW_S=60

# --- Cloudflare Tunnel (volitelné, pro docker-compose) --------
# Token tunelu z Cloudflare dashboardu (Zero Trust → Networks → Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=

# --- POER termostat (volitelné) --------------------------------
# API key z POER app (prefix cn/eu + token), např. cnxxxxxxxx nebo euxxxxxxxx.
LG_POER_API_KEY=

# --- Historie dat (data/history.db) ---
# LG_HISTORY_ENABLED=true
# Interval odečtu POER termostatů v sekundách (min. 60)
# LG_HISTORY_POLL_S=300
# Jak dlouho se historie uchovává (dny)
# LG_HISTORY_RETENTION_DAYS=90
# Příkon topení podle ID POER termostatu ve W (odhad kWh v exportu intervalů)
# LG_POER_POWER_W=fee89300f2a5:3500,fee89300fac5:560
