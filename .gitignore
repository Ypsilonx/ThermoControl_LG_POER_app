# .gitignore pro LG_projekt

# Virtuální prostředí
.venv/
venv/
env/

# Soubory s tokeny a citlivými údaji (ne šablony!)
data/config.json
data/devices.json
data/schedule.json
data/automation_rules.json
# Proměnné prostředí s tajemstvími (.env.example se commitne)
.env
# Šablony NEJSOU ignorovány - .example soubory se commitnou

# Nastavení editoru
.vscode/*
!.vscode/settings.json
.idea/

# Dočasné a záložní soubory
*.pyc
__pycache__/
*.pyo
*.pyd
*.bak
*.swp
*~

# Logy
*.log

# Testovací výstupy
*.out
*.tmp

# OS specifické
.DS_Store
Thumbs.db

# Build/dist složky (pokud budete balíčkovat)
build/
dist/
*.egg-info/

data/openapi.json
data/state.json
data/weather_cache.json
data/history.db*
